{
  "name": "@streamvi/streamvi-ui-kit",
  "private": false,
  "version": "0.0.0",
  "type": "module",
  "description": "StreamVi UI components for React and Material UI",
  "license": "MIT",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.ru.md",
    "THIRD-PARTY-NOTICES.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fonts.css": {
      "types": "./dist/fonts.css.d.ts",
      "default": "./dist/fonts.css"
    },
    "./fonts/inter.woff2": "./dist/fonts/inter.woff2"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@mui/utils": "^9.5.0",
    "@radix-ui/react-compose-refs": "^1.1.5",
    "clsx": "^2.1.1",
    "merge-sx": "^4.0.1"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
